# Copy to .env.local and fill in. .env.local is gitignored and never committed.

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (safe for the browser). New Supabase key format (replaces "anon").
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key (server side ONLY, never exposed to the browser). Replaces "service_role".
SUPABASE_SECRET_KEY=sb_secret_xxx
# Optional, only for running DB migrations via the Supabase CLI / a script:
# SUPABASE_DB_PASSWORD=

# ----- Google Gemini (server side ONLY) -----
GEMINI_API_KEY=your_gemini_key
# Optional. Defaults to gemini-2.5-flash (free tier). Override if needed.
# GEMINI_MODEL=gemini-2.5-flash
